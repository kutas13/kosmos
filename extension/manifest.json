{
  "manifest_version": 3,
  "name": "Kosmos başvuru doldurucu",
  "version": "1.6.2",
  "description": "Kosmos sihirbazı + Almanya pasaport takip (idata.com.tr) + yerel tesseract.js ile anında CAPTCHA OCR (offscreen).",
  "permissions": ["storage", "activeTab", "offscreen", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://basvuru.kosmosvize.com.tr/*",
    "https://www.idata.com.tr/*",
    "https://idata.com.tr/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://foxvize.info/*",
    "https://*.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kosmos doldur"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://basvuru.kosmosvize.com.tr/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.idata.com.tr/*",
        "https://idata.com.tr/*"
      ],
      "js": ["idata-content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://foxvize.info/*", "https://*.vercel.app/*"],
      "js": ["foxvize-bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/tesseract/*",
        "lib/tessdata/*"
      ],
      "matches": [
        "https://www.idata.com.tr/*",
        "https://idata.com.tr/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
